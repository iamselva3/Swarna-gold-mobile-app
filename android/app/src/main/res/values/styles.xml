<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is light-only; both launch and normal windows use the ivory canvas
         so there is no colour change between the native window and the Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_canvas</item>
    </style>
</resources>
